OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
POST_INTERVAL_MIN=30
# Meta (Instagram/Facebook/Threads) sync — optional. Leave empty to simulate.
# Get these from https://developers.facebook.com/apps/ → your app → Instagram Graph API
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_FB_PAGE_ID=
META_THREADS_USER_ID=
# Generated images are pushed to GitHub (raw.githubusercontent.com) before
# syncing to Meta, so the server process needs push access to origin/main.
